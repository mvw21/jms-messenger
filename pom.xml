        <!-- https://mvnrepository.com/artifact/org.hibernate/hibernate-tools -->
<!--        hibernate-tools is a very old Hibernate plugin used historically for:-->
<!--        reverse engineering DB schemas into entities-->
<!--        generating mappings (.hbm.xml files)-->
<!--        codegen outside runtime-->
<!--        It is not part of runtime Hibernate ORM or Spring Boot JPA, and:-->
<!--        It does not belong in a modern Spring Boot / JPA project-->
<!--        It conflicts with newer Hibernate versions managed by Spring Boot BOM-->
<!--        You aren’t using .hbm.xml anymore if you move to JPA annotations and Flyway-->
        <dependency>
            <groupId>org.hibernate</groupId>
            <artifactId>hibernate-tools</artifactId>
